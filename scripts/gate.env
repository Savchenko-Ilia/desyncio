# Commands run by scripts/gate.sh in a fresh worktree. uv creates the venv there and
# installs the locked dev dependencies (fast: uv reuses its global cache).
SETUP_CMD="uv sync --locked"
TEST_CMD="uv run pytest -q"
# Python 3.14 run: its own environment (.venv-3.14) so the default .venv used by
# TEST_CMD and LINT_CMD stays on 3.13. uv fails loudly if 3.14 cannot be found.
TEST_CMD_314="UV_PROJECT_ENVIRONMENT=.venv-3.14 uv run --locked --python 3.14 pytest -q"
LINT_CMD="uv run ruff check . && uv run ruff format --check . && uv run mypy src tests examples"
